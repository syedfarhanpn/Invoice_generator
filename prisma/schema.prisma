// schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Two application schemas share this database: the invoicing tables in
  // "public", and the CRM this app now also owns, which an earlier codebase
  // created in "crm". Declaring both lets one Prisma client read across them.
  schemas  = ["public", "crm"]
  // Connection URLs live in prisma.config.ts (Prisma 7+).
}

// Single-admin app: exactly one User row should ever exist (see
// src/lib/current-user.ts). clientSeq backs Client.clientNumber allocation.
enum Role {
  USER // a tenant: owns their own clients, documents and business profile
  SUPER_ADMIN // operator of the product: manages accounts, never reads tenant documents
  @@schema("public")
}

enum AccountStatus {
  ACTIVE
  SUSPENDED // can authenticate with Supabase, but is refused at getCurrentUser()
  @@schema("public")
}

// ---------------------------------------------------------------------------
// Workspace
//
// The product began as one-workspace-per-User: a Client belonged to a person,
// not to a company. That cannot express a team, which is what the business
// actually is - several people working the same clients, with "assigned to"
// and "project manager" meaning something.
//
// So business data hangs off an Organisation, and a User reaches it through a
// Membership that carries their role. `userId` stays on every row as the
// record of who created it; `orgId` is what scopes a query.
// ---------------------------------------------------------------------------

/// What a member may do. Enforced server-side in src/lib/permissions.ts -
/// hiding a nav item is presentation, not access control.
enum MemberRole {
  OWNER // the account the workspace was created from; cannot be demoted or removed
  ADMIN
  PROJECT_MANAGER
  SALES_EXECUTIVE
  DEVELOPER
  SUPPORT_EXECUTIVE
  ACCOUNTANT
  CONTENT_CREATOR

  @@schema("public")
}

enum MemberStatus {
  INVITED // invitation sent, never signed in
  ACTIVE
  SUSPENDED // kept, not deleted, so their authored rows keep a real author

  @@schema("public")
}

model Organisation {
  id   String @id @default(cuid())
  name String
  /// Stable handle for URLs and for addressing the workspace in an invite.
  slug String @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members     Membership[]
  departments Department[]

  businessProfiles BusinessProfile[]
  clients          Client[]
  documents        Document[]
  payments         Payment[]
  apiKeys          ApiKey[]
  pipelines        Pipeline[]
  deals            Deal[]
  projects         Project[]
  contacts         Contact[]
  companyProfiles  CompanyProfile[]
  activities       Activity[]
  tasks            Task[]
  expenses         Expense[]
  subscriptions    Subscription[]
  tickets          Ticket[]
  syncLogs         SyncLog[]
  permissionGrants PermissionGrant[]
  memberAuditLogs  MemberAuditLog[]

  @@schema("public")
}

/// A person's place in a workspace. One row per (org, user).
model Membership {
  id     String       @id @default(cuid())
  orgId  String
  org    Organisation @relation(fields: [orgId], references: [id], onDelete: Cascade)
  userId String
  user   User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  role   MemberRole   @default(DEVELOPER)
  status MemberStatus @default(INVITED)

  /// Free-text job title, shown beside the name. Distinct from `role`, which
  /// is what the server checks.
  title        String?
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  invitedAt    DateTime?
  joinedAt     DateTime?
  lastActiveAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assignedDeals   Deal[]    @relation("DealAssignee")
  managedProjects Project[] @relation("ProjectManager")
  assignedTasks   Task[]    @relation("TaskAssignee")
  recordedExpenses Expense[] @relation("ExpenseRecorder")
  ownedSubscriptions Subscription[] @relation("SubscriptionOwner")
  assignedTickets    Ticket[]       @relation("TicketAssignee")
  ticketReplies      TicketReply[]  @relation("TicketReplyAuthor")
  permissionGrants   PermissionGrant[]
  auditActions       MemberAuditLog[] @relation("MemberAuditActor")
  auditTargets       MemberAuditLog[] @relation("MemberAuditTarget")

  @@unique([orgId, userId])
  @@index([orgId, status])
  @@schema("public")
}

// ---------------------------------------------------------------------------
// Permissions (schema "public")
//
// MemberRole existed before this and enforced nothing - it was a label in a
// dropdown. These rows are what a workspace sets ON TOP of the built-in
// defaults in src/lib/permissions.ts, and src/lib/access.ts is the gate that
// applies them on the server. Hiding a nav item is not access control.
//
// A grant is either for a ROLE (everyone holding it) or for one MEMBERSHIP
// (that person alone), never both and never neither - enforced by a CHECK, so
// a row cannot exist that nothing would ever read.
// ---------------------------------------------------------------------------

enum PermissionAccess {
  NONE // a decision to revoke, not the absence of one
  READ
  WRITE

  @@schema("public")
}

model PermissionGrant {
  id    String       @id @default(cuid())
  orgId String
  org   Organisation @relation(fields: [orgId], references: [id], onDelete: Cascade)

  /// Set for a role-wide grant. Null for a per-person one.
  role MemberRole?
  /// Set for a per-person grant. Null for a role-wide one.
  membershipId String?
  membership   Membership? @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  /// One of src/lib/permissions.ts MODULES. Text rather than an enum because
  /// the module list grows with the product and an enum would mean a
  /// migration each time. An unrecognised value grants nothing - the resolver
  /// only ever looks up modules it knows, so this fails closed.
  module String
  access PermissionAccess

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Postgres allows many NULLs under a unique index, so the role-wide and
  /// per-person uniques do not collide with each other.
  @@unique([orgId, role, module])
  @@unique([membershipId, module])
  @@index([orgId])
  @@schema("public")
}

/// Append-only record of what was done to whom in a workspace. Nothing
/// deletes from here: if someone's role was changed or their access revoked,
/// that has to stay provable afterwards.
model MemberAuditLog {
  id    String       @id @default(cuid())
  orgId String
  org   Organisation @relation(fields: [orgId], references: [id], onDelete: Cascade)

  /// Who did it, and who it was done to. Both nullable and both SET NULL, so
  /// removing a membership never erases the history of their actions.
  actorId  String?
  actor    Membership? @relation("MemberAuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  targetId String?
  target   Membership? @relation("MemberAuditTarget", fields: [targetId], references: [id], onDelete: SetNull)

  /// A stable key, e.g. "member.role_changed", for filtering.
  action String
  /// The sentence shown in the activity list, written when it happened -
  /// rebuilding it later from ids that may since have been nulled would turn
  /// history into guesswork.
  summary String
  meta    Json?

  createdAt DateTime @default(now())

  @@index([orgId, createdAt])
  @@schema("public")
}

/// Sales, Development, Operations, Admin. Expenses are attributed to one of
/// these when they are overhead rather than billable to a project.
model Department {
  id    String       @id @default(cuid())
  orgId String
  org   Organisation @relation(fields: [orgId], references: [id], onDelete: Cascade)
  name  String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members  Membership[]
  expenses Expense[]

  @@unique([orgId, name])
  @@schema("public")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  passwordHash  String?
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]

  businessProfile BusinessProfile?
  clients         Client[]
  documents       Document[]
  clientSeq       Int       @default(0) // next Client.clientNumber to hand out
  ticketSeq       Int       @default(0) // next Ticket.number to hand out

  // Access control. Authentication is Supabase's job; authorization is ours,
  // and it lives here rather than in an env var so accounts can be managed at
  // runtime. SUPER_ADMIN_EMAIL survives only as the bootstrap/break-glass
  // path - see src/lib/current-user.ts.
  role        Role          @default(USER)
  status      AccountStatus @default(ACTIVE)
  suspendedAt DateTime?
  lastLoginAt DateTime?

  memberships     Membership[]

  // CRM (schema "crm")
  pipelines       Pipeline[]
  deals           Deal[]
  projects        Project[]
  contacts        Contact[]
  companyProfiles CompanyProfile[]
  activities      Activity[]
  tasks           Task[]
  expenses        Expense[]
  subscriptions   Subscription[]
  tickets         Ticket[]
  syncLogs        SyncLog[]

  apiKeys        ApiKey[]
  payments       Payment[]
  idempotency    IdempotencyRecord[]
  auditActions AdminAuditLog[] @relation("AdminAuditActor")
  auditTargets AdminAuditLog[] @relation("AdminAuditTarget")

  createdAt DateTime @default(now())

  @@index([role])
  @@index([status])
  @@schema("public")
}

/// Append-only record of every account action a super admin takes. Nothing
/// deletes from here - if an account was suspended or promoted, that fact must
/// remain provable after the fact.
model AdminAuditLog {
  id      String @id @default(cuid())
  actorId String
  actor   User   @relation("AdminAuditActor", fields: [actorId], references: [id], onDelete: Cascade)

  // Null for actions that are not about one specific account.
  targetUserId String?
  target       User?   @relation("AdminAuditTarget", fields: [targetUserId], references: [id], onDelete: SetNull)

  action String // "user.provisioned" | "user.suspended" | "user.restored" | "user.role_changed"
  meta   Json?

  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([actorId, createdAt])
  @@index([targetUserId, createdAt])
  @@schema("public")
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?  @db.Text
  access_token       String?  @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?  @db.Text
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@schema("public")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@schema("public")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@schema("public")
}

model BusinessProfile {
  id            String   @id @default(cuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  orgId  String?
  org    Organisation? @relation(fields: [orgId], references: [id], onDelete: Cascade)
  businessName  String
  ownerName     String
  email         String
  phone         String?
  address       String?
  website       String?
  taxId         String?
  logoUrl       String?
  brandColor    String?  @default("#000000")
  paymentMethod String?
  bankName      String?
  accountNumber String?
  routingSwift  String?
  upiId         String?  // UPI VPA for QR-based payment, e.g. name@bank (phase 2 QR code)
  currency      String?  @default("USD") // default currency for new documents

  // Defaults copied onto new documents; editable per-document afterwards.
  defaultTaxMode         TaxMode  @default(NONE)
  defaultTaxRate         Decimal? @db.Decimal(5, 2)
  defaultTaxLabel        String?
  defaultPaymentTermDays Int?     @default(15)

  // Pre-filled into the Notes field of every new invoice-family document, so
  // standard wording is not retyped each time. Editable per document.
  defaultInvoiceNote     String?

  // How generated documents look: the paper they print on and the typeface
  // they are set in. Both are snapshotted onto a document at finalize time,
  // so changing them later never restyles an invoice already sent.
  // See src/lib/document-theme.ts for the derived palette.
  paperColor         String?  @default("#ffffff")
  documentFont       String?  @default("serif")

  // Signature shown on contracts as the issuer's counter-signature.
  signatureName      String?
  signatureImageUrl  String?

  updatedAt DateTime @updatedAt
  @@index([orgId])
  @@schema("public")
}

// A client's `code` (e.g. "ACME") is auto-suggested from their business name
// and is editable up until their first document is finalized - after that it
// is locked server-side, because every issued refNumber embeds it
// (INV-ACME-001) and an edited code would orphan historical serials.
model Client {
  id              String     @id @default(cuid())
  userId          String
  user            User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  orgId  String?
  org    Organisation? @relation(fields: [orgId], references: [id], onDelete: Cascade)
  clientNumber    Int        // sequential internal id, assigned from User.clientSeq
  code            String     // short uppercase code used in document serials
  fullName        String
  businessName    String?
  email           String
  phone           String?
  address         String?
  country         String?
  taxId           String?    // GSTIN or equivalent, shown on invoices when set
  notes           String?
  tags            String[]   // e.g. ["active", "video", "high-value"]
  defaultCurrency String?    // overrides BusinessProfile.currency for this client

  // Identity in the system that pushed this record (CRM, etc). Nullable, and
  // Postgres allows many NULLs under a unique index, so hand-created clients
  // are unaffected. This is what makes a re-sync an update instead of a
  // duplicate.
  externalId   String?
  sourceSystem String?
  archivedAt      DateTime?

  // Per-client serial counters. Incremented transactionally in
  // src/lib/allocate-ref.ts when a document is finalized - never on create,
  // so deleting a draft never leaves a gap in issued numbers.
  // Each type counts separately so converting a quote into an invoice never
  // burns an invoice number, and INV- stays gapless on its own.
  invoiceSeq  Int @default(0)
  contractSeq Int @default(0)
  quoteSeq    Int @default(0)
  proformaSeq Int @default(0)
  receiptSeq  Int @default(0)

  documents Document[]

  // CRM (schema "crm")
  deals           Deal[]
  projects        Project[]
  contacts        Contact[]
  companyProfiles CompanyProfile[]
  activities      Activity[]
  tasks           Task[]
  subscriptions   Subscription[]
  tickets         Ticket[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@unique([userId, code])
  @@unique([userId, externalId])
  @@index([userId, archivedAt])
  @@index([userId, createdAt])
  @@index([orgId])
  @@schema("public")
}

enum DocumentType {
  INVOICE
  CONTRACT
  QUOTE    // quotation / estimate - converts to an INVOICE once accepted
  PROFORMA // proforma invoice - converts to an INVOICE once confirmed
  @@schema("public")
}

// Lifecycle only - money status (paid/partial/overdue) is derived from
// Document.amountPaid vs totalAmount/dueDate, not stored here, so it can
// never drift out of sync with the Payment ledger.
enum DocumentStatus {
  DRAFT     // editable, unnumbered, not shareable
  FINALIZED // numbered + snapshotted + shareable; "SENT" for invoices
  SIGNED    // contracts only, after e-signature; permanently locked
  VOID      // cancelled after finalize; number stays allocated (no reuse)
  ARCHIVED
  @@schema("public")
}

enum TaxMode {
  NONE
  PERCENTAGE
  @@schema("public")
}

model Document {
  id       String @id @default(cuid())
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  orgId  String?
  org    Organisation? @relation(fields: [orgId], references: [id], onDelete: Cascade)
  clientId String?
  client   Client? @relation(fields: [clientId], references: [id], onDelete: Cascade)

  type   DocumentType
  status DocumentStatus @default(DRAFT)

  // refNumber/sequence are NULL while DRAFT and assigned atomically on
  // finalize by src/lib/allocate-ref.ts, e.g. "INV-ACME-001" / sequence 1.
  refNumber String?
  sequence  Int?

  title   String?
  content Json // line items / clauses; frozen (no longer read from live
  // Client/BusinessProfile rows) once status leaves DRAFT - see
  // src/lib/snapshot.ts

  currency String  @default("USD")
  taxMode  TaxMode @default(NONE)
  taxRate  Decimal? @db.Decimal(5, 2)
  taxLabel String?

  subtotal    Decimal? @db.Decimal(12, 2)
  taxAmount   Decimal? @db.Decimal(12, 2)
  totalAmount Decimal? @db.Decimal(12, 2)
  amountPaid  Decimal  @default(0) @db.Decimal(12, 2)

  // Money already in hand before this invoice was raised - a prior advance or
  // an earlier milestone payment. Deducted from the total on the printed
  // document to give the balance due. Distinct from amountPaid, which is the
  // Payment ledger for THIS document; both count as received (see
  // paymentSummary in src/lib/money.ts).
  advanceReceived Decimal @default(0) @db.Decimal(12, 2)

  issueDate DateTime?
  dueDate   DateTime?

  finalizedAt DateTime?

  publicSlug    String?    @unique // random token, not derived from id
  slugRevokedAt DateTime?

  signatureData Json? // e-signature payload for CONTRACT documents
  contentHash   String? // sha256 of `content` at finalize/sign time, so a

  // later edit can never be passed off as what was actually signed
  // Set on the INVOICE created from an accepted QUOTE/PROFORMA. The source
  // document keeps its own number and is never mutated - conversion copies
  // forward, so both sides stay independently auditable.
  externalId   String?
  sourceSystem String?

  convertedFromId String?
  convertedFrom   Document?  @relation("DocumentConversion", fields: [convertedFromId], references: [id], onDelete: SetNull)
  convertedTo     Document[] @relation("DocumentConversion")

  payments Payment[]
  activity DocumentActivity[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, refNumber])
  @@unique([userId, externalId])
  @@index([userId, type])
  @@index([userId, status])
  // Covers the list pages: WHERE userId = ? ORDER BY createdAt DESC. Without
  // it Postgres can filter or sort from an index, but not both.
  @@index([userId, createdAt])
  @@index([convertedFromId])
  @@index([clientId])
  @@index([orgId])
  @@schema("public")
}

/// Per-tenant API credential for the public REST surface (src/app/api/v1).
/// Only a SHA-256 of the secret is stored - the plaintext is shown once at
/// creation and is unrecoverable afterwards.
model ApiKey {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  orgId  String?
  org    Organisation? @relation(fields: [orgId], references: [id], onDelete: Cascade)

  name String // human label, e.g. "HubSpot production"

  /// Public, non-secret prefix used to find the row before verifying the
  /// hash. Indexed so lookup never scans, and safe to display in the UI.
  lookupId String @unique
  keyHash  String // sha256 of the full secret

  lastUsedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId, revokedAt])
  @@index([orgId])
  @@schema("public")
}

/// Replay protection for unsafe API calls. A retried POST with the same
/// Idempotency-Key returns the stored response instead of creating a second
/// client or document.
model IdempotencyRecord {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  key      String
  endpoint String
  /// Hash of the request body, so the same key sent with different content is
  /// rejected rather than silently returning the wrong stored response.
  requestHash    String
  responseStatus Int
  responseBody   Json

  createdAt DateTime @default(now())

  @@unique([userId, key])
  @@index([createdAt])
  @@schema("public")
}

model Payment {
  id         String   @id @default(cuid())
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  // Denormalised from the parent document so a receipt number can carry the
  // same @@unique backstop the document serials have - Payment is otherwise
  // only reachable through Document and could not be scoped per tenant.
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  orgId  String?
  org    Organisation? @relation(fields: [orgId], references: [id], onDelete: Cascade)

  // Allocated when the payment is recorded, e.g. RCP-ACME-001. A receipt
  // acknowledges money that has already moved, so unlike a document it is
  // never a draft and never needs finalising.
  receiptNumber String?
  sequence      Int?
  amount     Decimal  @db.Decimal(12, 2)
  paidOn     DateTime
  method     String? // "UPI", "Bank transfer", "Cash", ...
  reference  String?
  note       String?
  createdAt  DateTime @default(now())

  @@unique([userId, receiptNumber])
  @@index([documentId])
  @@index([userId, paidOn])
  @@index([orgId])
  @@schema("public")
}

model DocumentActivity {
  id         String   @id @default(cuid())
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  event      String // "created" | "finalized" | "shared" | "viewed" |
  // "downloaded" | "signed" | "payment_recorded" | "voided"
  meta      Json?
  createdAt DateTime @default(now())

  @@index([documentId, createdAt])
  @@schema("public")
}

// ---------------------------------------------------------------------------
// CRM (schema "crm")
//
// Created by an earlier codebase against this same database and adopted here
// rather than rebuilt: it already carries real foreign keys into public.User
// and public.Client, so a deal, a contact and a task all hang off the same
// client the invoices do. Stages live in rows, not in an enum, so the pipeline
// is configuration the operator edits rather than a deploy.
//
// Migrations for these tables are tracked in crm._prisma_migrations by that
// original app. This block describes the tables; it does not re-create them.
// ---------------------------------------------------------------------------

enum ActivityType {
  NOTE
  CALL
  EMAIL
  MEETING
  STAGE_CHANGE
  DEAL_WON
  DEAL_LOST
  CLIENT_SYNCED
  TASK_COMPLETED

  @@schema("crm")
}

enum DealOutcome {
  WON
  LOST

  @@schema("crm")
}

enum LifecycleStage {
  LEAD
  PROSPECT
  ACTIVE
  DORMANT
  CHURNED

  @@schema("crm")
}

/// OPEN stages sit in the pipeline; WON and LOST close a deal and are what the
/// board reads to decide where a stage move ends the story.
///
/// The same three apply to every board kind: a project's "Completed" is a WON
/// stage and its "Cancelled" is LOST, a task's "Done" is WON. Only the names
/// differ, which is the point - one board implementation, three panels.
enum StageType {
  OPEN
  WON
  LOST

  @@schema("crm")
}

/// What a board holds.
///
/// Leads, projects and tasks are the same primitive: ordered cards in named
/// columns. Discriminating the pipeline rather than building three board
/// systems is what makes "customise the stages" one settings screen instead
/// of three, and lets one drag-and-drop implementation serve all of them.
enum PipelineKind {
  LEADS
  PROJECTS
  TASKS

  @@schema("crm")
}

enum SyncDirection {
  PUSH
  PULL

  @@schema("crm")
}

enum SyncStatus {
  SUCCESS
  FAILED

  @@schema("crm")
}

enum TaskPriority {
  LOW
  NORMAL
  HIGH

  @@schema("crm")
}

enum TaskStatus {
  OPEN
  DONE
  CANCELLED

  @@schema("crm")
}

model Pipeline {
  id         String    @id
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  orgId  String?
  org    Organisation? @relation(fields: [orgId], references: [id], onDelete: Cascade)
  name       String
  /// Existing rows predate the other two panels, so they are LEADS.
  kind       PipelineKind @default(LEADS)
  isDefault  Boolean
  position   Int
  archivedAt DateTime?
  createdAt  DateTime
  updatedAt  DateTime

  stages   Stage[]
  deals    Deal[]
  projects Project[]
  tasks    Task[]

  // Both already exist in the database, created by the earlier codebase.
  // Declared here so the model stops disagreeing with the table:
  //   Pipeline_userId_name_key       UNIQUE (userId, name)
  //   Pipeline_one_default_per_user  UNIQUE (userId) WHERE isDefault
  // The second is partial and has no Prisma equivalent, so src/lib/boards.ts
  // enforces it when creating a board.
  @@unique([userId, name])
  @@index([orgId])
  @@schema("crm")
}

model Stage {
  id          String @id
  pipelineId  String
  pipeline    Pipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  name        String
  position    Int
  /// Win likelihood at this stage, used for weighted pipeline value. Only
  /// meaningful on a LEADS board; the other kinds carry zero.
  probability Int
  type        StageType
  createdAt   DateTime
  updatedAt   DateTime

  deals    Deal[]
  projects Project[]
  tasks    Task[]

  @@schema("crm")
}

/// An opportunity. Separate from Client on purpose: a client can be quoted
/// twice, and a deal that never closes must not fill the client list.
model Deal {
  id               String    @id
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  orgId  String?
  org    Organisation? @relation(fields: [orgId], references: [id], onDelete: Cascade)
  title            String
  description      String?
  clientId         String?
  client           Client?   @relation(fields: [clientId], references: [id])
  primaryContactId String?
  primaryContact   Contact?  @relation(fields: [primaryContactId], references: [id])
  pipelineId       String
  pipeline         Pipeline  @relation(fields: [pipelineId], references: [id])
  stageId          String
  stage            Stage     @relation(fields: [stageId], references: [id])
  value            Decimal?
  currency         String
  probability      Int?
  expectedCloseDate DateTime?
  closedAt         DateTime?
  outcome          DealOutcome?
  lostReason       String?
  source           String?
  /// Order within its stage column on the board.
  position         Int
  archivedAt       DateTime?
  createdAt        DateTime
  updatedAt        DateTime

  /// The member working this lead. Nullable: an unassigned lead is a real
  /// state, and the one the inbox is meant to surface.
  assignedToId String?
  assignedTo   Membership? @relation("DealAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)

  activities Activity[]
  tasks      Task[]
  project    Project?

  @@index([orgId])

  @@schema("crm")
}

/// A person. Attaches to a Client once there is one, and stands alone before.
model Contact {
  id          String    @id
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  orgId  String?
  org    Organisation? @relation(fields: [orgId], references: [id], onDelete: Cascade)
  clientId    String?
  client      Client?   @relation(fields: [clientId], references: [id])
  firstName   String
  lastName    String?
  email       String?
  phone       String?
  jobTitle    String?
  linkedinUrl String?
  notes       String?
  isPrimary   Boolean
  archivedAt  DateTime?
  createdAt   DateTime
  updatedAt   DateTime

  deals      Deal[]
  activities Activity[]
  tasks      Task[]
  tickets    Ticket[]

  @@index([orgId])

  @@schema("crm")
}

/// Work in flight, on its own board.
///
/// Separate from Deal because selling the work and doing the work are
/// different lifecycles: a deal is done when it closes, a project starts
/// there. A won deal can seed one, but never silently - not every win is a
/// project, so the prompt is offered and can be declined.
model Project {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  orgId  String?
  org    Organisation? @relation(fields: [orgId], references: [id], onDelete: Cascade)
  pipelineId   String
  pipeline     Pipeline  @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  stageId      String
  stage        Stage     @relation(fields: [stageId], references: [id])
  clientId     String?
  client       Client?   @relation(fields: [clientId], references: [id])
  /// The deal this was started from, when it was started from one. Unique:
  /// accepting the prompt twice must not produce two projects.
  sourceDealId String?   @unique
  sourceDeal   Deal?     @relation(fields: [sourceDealId], references: [id])

  title       String
  description String?
  value       Decimal?  @db.Decimal(12, 2)
  currency    String    @default("INR")
  startedAt   DateTime?
  deadline    DateTime?
  /// Order within its stage column on the board.
  position    Int       @default(0)
  archivedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  /// Who owns delivery. Separate from whoever created the row.
  managerId String?
  manager   Membership? @relation("ProjectManager", fields: [managerId], references: [id], onDelete: SetNull)

  /// What kind of work this is - E-commerce, Portfolio, AMC. Free text rather
  /// than an enum, because the list of things an agency sells changes faster
  /// than a deploy does.
  category String?

  /// Delivery progress, 0-100, as the operator judges it. Explicit rather
  /// than derived from task completion: a project can be 80% done with two
  /// trivial tasks left. Task counts are shown beside this, not instead of it.
  progress Int?

  tasks         Task[]
  expenses      Expense[]
  subscriptions Subscription[]
  tickets       Ticket[]

  @@index([userId, stageId, position])
  @@index([orgId])
  @@index([managerId])
  @@schema("crm")
}

/// The commercial facts about a Client that invoicing has no use for.
model CompanyProfile {
  id             String   @id
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  orgId  String?
  org    Organisation? @relation(fields: [orgId], references: [id], onDelete: Cascade)
  clientId       String
  client         Client   @relation(fields: [clientId], references: [id])
  website        String?
  industry       String?
  employeeCount  String?
  lifecycleStage LifecycleStage
  accountManager String?
  source         String?
  linkedinUrl    String?
  createdAt      DateTime
  updatedAt      DateTime

  @@index([orgId])

  @@schema("crm")
}

/// Append-only trail. Stage moves, calls, notes and syncs all land here, so a
/// deal's history reads in one query.
model Activity {
  id         String       @id
  userId     String
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  orgId  String?
  org    Organisation? @relation(fields: [orgId], references: [id], onDelete: Cascade)
  type       ActivityType
  subject    String?
  body       String?
  occurredAt DateTime
  dealId     String?
  deal       Deal?        @relation(fields: [dealId], references: [id])
  clientId   String?
  client     Client?      @relation(fields: [clientId], references: [id])
  contactId  String?
  contact    Contact?     @relation(fields: [contactId], references: [id])
  meta       Json?
  createdAt  DateTime

  @@index([orgId])

  @@schema("crm")
}

/// The follow-up. dueAt is what the agenda view and the calendar read.
model Task {
  id          String       @id
  userId      String
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  orgId  String?
  org    Organisation? @relation(fields: [orgId], references: [id], onDelete: Cascade)
  title       String
  notes       String?
  status      TaskStatus
  priority    TaskPriority
  dueAt       DateTime?
  completedAt DateTime?
  dealId      String?
  deal        Deal?        @relation(fields: [dealId], references: [id])
  clientId    String?
  client      Client?      @relation(fields: [clientId], references: [id])
  contactId   String?
  contact     Contact?     @relation(fields: [contactId], references: [id])
  projectId   String?
  project     Project?     @relation(fields: [projectId], references: [id], onDelete: Cascade)

  // Board placement. Nullable because tasks predate the task board and a
  // follow-up created against a deal still belongs to no column - `status`
  // remains the source of truth for done-ness, and the board reads it.
  pipelineId String?
  pipeline   Pipeline? @relation(fields: [pipelineId], references: [id], onDelete: SetNull)
  stageId    String?
  stage      Stage?    @relation(fields: [stageId], references: [id], onDelete: SetNull)
  /// Order within its stage column on the board.
  position   Int       @default(0)

  /// When to raise it. Kept apart from dueAt so a reminder can lead the
  /// deadline - "tell me the morning before" is a different fact from "it is
  /// due at 5pm".
  remindAt   DateTime?
  /// Stamped once the reminder has been surfaced, so it is raised once and
  /// not on every poll.
  notifiedAt DateTime?

  assigneeId String?
  assignee   Membership? @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  createdAt   DateTime
  updatedAt   DateTime

  @@index([userId, status, remindAt])
  @@index([userId, stageId, position])
  @@index([orgId])
  @@schema("crm")
}

// ---------------------------------------------------------------------------
// Expenses (schema "crm")
//
// Money going out. Every expense is either attributable to one project or it
// is company overhead - never both, and never neither. That is a discriminator
// rather than a nullable projectId, because "no project set" and "deliberately
// overhead" are different facts, and a report that cannot tell them apart will
// either double-count or silently drop the overhead.
// ---------------------------------------------------------------------------

/// What an expense is attributable to. The database enforces the pairing with
/// projectId - see the CHECK in the migration.
enum ExpenseScope {
  PROJECT  // attributable to one project; projectId required
  OVERHEAD // company-wide; projectId must be null

  @@schema("crm")
}

enum ExpenseStatus {
  PAID
  PENDING
  PARTIALLY_PAID
  OVERDUE

  @@schema("crm")
}

/// How often a cost repeats. ONE_OFF is the default so nothing silently
/// recurs; a recurring expense carries nextDueOn and the renewals view reads it.
enum ExpenseRecurrence {
  ONE_OFF
  MONTHLY
  QUARTERLY
  YEARLY

  @@schema("crm")
}

model Expense {
  id     String        @id @default(cuid())
  userId String
  user   User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  orgId  String?
  org    Organisation? @relation(fields: [orgId], references: [id], onDelete: Cascade)

  title    String
  /// Free text, seeded from the operator settings rather than an enum: the
  /// categories an agency tracks change faster than a deploy does.
  category String
  amount   Decimal  @db.Decimal(12, 2)
  currency String   @default("INR")
  spentOn  DateTime

  vendor        String?
  paymentMethod String?
  status        ExpenseStatus @default(PAID)
  notes         String?

  /// The attribution. See the note at the top of this block.
  scope     ExpenseScope @default(OVERHEAD)
  projectId String?
  project   Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)

  /// Which part of the business carried it. Independent of scope: a project
  /// cost still belongs to a department.
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  recurrence ExpenseRecurrence @default(ONE_OFF)
  /// When the next instance falls due. Null for a one-off.
  nextDueOn  DateTime?

  /// The renewal this payment settled, when it settled one. A Subscription
  /// records what is COMMITTED; this row records what was actually PAID.
  /// Reports read the expense and treat the subscription as the reason, so a
  /// renewal is counted once rather than once per table.
  subscriptionId String?
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  /// Who entered it, for the activity trail.
  recordedById String?
  recordedBy   Membership? @relation("ExpenseRecorder", fields: [recordedById], references: [id], onDelete: SetNull)

  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([userId, spentOn])
  @@index([orgId])
  @@index([projectId])
  @@index([departmentId])
  @@index([userId, scope])
  @@index([subscriptionId])
  @@schema("crm")
}

// ---------------------------------------------------------------------------
// Subscriptions (schema "crm")
//
// AMCs, domains, hosting and SSL are the same fact wearing different words: a
// commitment that costs money, belongs to someone, and comes due on a date.
// One table rather than three, because the screen that earns its keep is "what
// expires in the next sixty days" ACROSS all of them - three tables would make
// that three queries and a merge, and every new kind of service an agency
// resells would be another table with its own renewal arithmetic to keep in
// step. `kind` is what the Renewals and Domains pages filter on.
//
// Note what is NOT stored: whether something is expiring, overdue or lapsed.
// All three are `renewsOn` compared against now, and a stored copy would go
// stale the moment nobody opened the page. Status carries only what a date
// cannot say - that the operator deliberately let it go.
// ---------------------------------------------------------------------------

enum SubscriptionKind {
  AMC // an annual maintenance contract sold to a client - revenue, not cost
  DOMAIN
  HOSTING
  SSL
  EMAIL
  OTHER

  @@schema("crm")
}

/// How long one paid period lasts. The long cycles exist because domains are
/// routinely registered two and three years at a time.
enum BillingCycle {
  MONTHLY
  QUARTERLY
  HALF_YEARLY
  YEARLY
  BIENNIAL
  TRIENNIAL

  @@schema("crm")
}

/// Deliberately two values. "Expiring", "due" and "overdue" are all derived
/// from renewsOn - see the note above.
enum SubscriptionStatus {
  ACTIVE
  CANCELLED // we are letting it lapse, or it already has

  @@schema("crm")
}

model Subscription {
  id     String        @id @default(cuid())
  userId String
  user   User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  orgId  String?
  org    Organisation? @relation(fields: [orgId], references: [id], onDelete: Cascade)

  kind SubscriptionKind
  /// What it is: "pixiewebs.com", "Curefully AMC", "Hostinger Business".
  name String

  /// Whose it is. Null means the company's own - our domain, our hosting.
  clientId  String?
  client    Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)
  /// The work it supports, when there is one.
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  /// Registrar, host, or whoever we pay. Null for an AMC, where we are paid.
  provider String?
  /// The account or reference the service sits under at the provider. An
  /// identifier only - never a password, and never anything that could be
  /// used to sign in.
  accountRef String?

  startsOn DateTime
  /// The one date every renewal view reads.
  renewsOn DateTime
  cycle    BillingCycle @default(YEARLY)

  /// What we pay out per cycle. Null when nothing leaves the business.
  cost     Decimal? @db.Decimal(12, 2)
  /// What the client pays us per cycle. Null when nobody is billed - our own
  /// domain, for instance. Kept apart from cost so the margin on resold
  /// hosting is a recorded fact rather than a subtraction nobody did.
  price    Decimal? @db.Decimal(12, 2)
  currency String   @default("INR")

  /// Whether the provider renews it without us doing anything. It changes
  /// what an approaching date MEANS: a reminder to pay, or one to budget.
  autoRenew Boolean            @default(false)
  status    SubscriptionStatus @default(ACTIVE)

  /// When it was last put through a renewal, so "renewed yesterday" and
  /// "never touched since it was added" are distinguishable.
  lastRenewedAt DateTime?

  /// Who is responsible for renewing it.
  ownerId String?
  owner   Membership? @relation("SubscriptionOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  notes String?

  /// The payments actually made against it. A Subscription says what is
  /// committed; an Expense says what left the bank. Keeping the two separate
  /// and linked is what stops a report counting one renewal twice.
  expenses Expense[]

  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([userId, renewsOn])
  @@index([userId, kind, renewsOn])
  @@index([orgId])
  @@index([clientId])
  @@index([projectId])
  @@schema("crm")
}

// ---------------------------------------------------------------------------
// Support tickets (schema "crm")
//
// A ticket is a conversation with a state, which is why it is not a Task. A
// task is something one person does; a ticket is something a client is waiting
// on, and the waiting is the part that has to be visible.
// ---------------------------------------------------------------------------

enum TicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_ON_CLIENT // the ball is not in our court; not "needs a reply"
  RESOLVED
  CLOSED

  @@schema("crm")
}

/// Its own enum rather than TaskPriority, which has no URGENT. Sharing one
/// would mean a vocabulary change for tickets silently reshaping the task
/// board.
enum TicketPriority {
  LOW
  NORMAL
  HIGH
  URGENT

  @@schema("crm")
}

enum TicketChannel {
  EMAIL
  PHONE
  WHATSAPP
  IN_PERSON
  PORTAL
  OTHER

  @@schema("crm")
}

/// Whether a reply is something the client may see. An internal note that
/// leaked into a client-facing thread is the one failure this module cannot
/// have, so it is a column rather than a convention.
enum TicketReplyVisibility {
  PUBLIC
  INTERNAL

  @@schema("crm")
}

model Ticket {
  id     String        @id @default(cuid())
  userId String
  user   User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  orgId  String?
  org    Organisation? @relation(fields: [orgId], references: [id], onDelete: Cascade)

  /// Sequential per workspace, allocated from User.ticketSeq under the same
  /// row lock documents use. Rendered as TKT-014.
  number Int

  subject String
  /// What was first reported. Everything after it lives in TicketReply.
  body    String?

  clientId  String?
  client    Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  /// Who raised it, when that is a person we hold a record for.
  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)

  status   TicketStatus   @default(OPEN)
  priority TicketPriority @default(NORMAL)
  channel  TicketChannel  @default(EMAIL)

  assigneeId String?
  assignee   Membership? @relation("TicketAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  /// When a reply is promised by. Null means nothing was promised - which is
  /// a different fact from "promised and not yet late".
  dueAt DateTime?
  /// Stamped by the first PUBLIC reply, so response time is measured rather
  /// than estimated.
  firstRespondedAt DateTime?
  resolvedAt       DateTime?
  closedAt         DateTime?

  replies TicketReply[]

  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([userId, number])
  @@index([userId, status, createdAt])
  @@index([orgId])
  @@index([clientId])
  @@index([projectId])
  @@index([assigneeId])
  @@schema("crm")
}

model TicketReply {
  id       String @id @default(cuid())
  ticketId String
  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  body String

  /// Who wrote it. Null when it came from the client rather than the team.
  authorId String?
  author   Membership? @relation("TicketReplyAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  /// Direction and visibility are different facts: a message FROM the client
  /// is always public, but a message from us may be an internal note.
  fromClient Boolean               @default(false)
  visibility TicketReplyVisibility @default(PUBLIC)

  createdAt DateTime @default(now())

  @@index([ticketId, createdAt])
  @@schema("crm")
}

/// Every exchange with an outside system, kept whether it succeeded or not, so
/// a failed Meta pull is visible instead of silent.
model SyncLog {
  id         String        @id
  userId     String
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  orgId  String?
  org    Organisation? @relation(fields: [orgId], references: [id], onDelete: Cascade)
  direction  SyncDirection
  entity     String
  localId    String?
  remoteId   String?
  status     SyncStatus
  statusCode Int?
  error      String?
  payload    Json?
  createdAt  DateTime

  @@index([orgId])

  @@schema("crm")
}
