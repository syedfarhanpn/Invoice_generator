// schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Two application schemas share this database: the invoicing tables in
  // "public", and the CRM this app now also owns, which an earlier codebase
  // created in "crm". Declaring both lets one Prisma client read across them.
  schemas  = ["public", "crm"]
  // Connection URLs live in prisma.config.ts (Prisma 7+).
}

// Single-admin app: exactly one User row should ever exist (see
// src/lib/current-user.ts). clientSeq backs Client.clientNumber allocation.
enum Role {
  USER // a tenant: owns their own clients, documents and business profile
  SUPER_ADMIN // operator of the product: manages accounts, never reads tenant documents
  @@schema("public")
}

enum AccountStatus {
  ACTIVE
  SUSPENDED // can authenticate with Supabase, but is refused at getCurrentUser()
  @@schema("public")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  passwordHash  String?
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]

  businessProfile BusinessProfile?
  clients         Client[]
  documents       Document[]
  clientSeq       Int       @default(0) // next Client.clientNumber to hand out

  // Access control. Authentication is Supabase's job; authorization is ours,
  // and it lives here rather than in an env var so accounts can be managed at
  // runtime. SUPER_ADMIN_EMAIL survives only as the bootstrap/break-glass
  // path - see src/lib/current-user.ts.
  role        Role          @default(USER)
  status      AccountStatus @default(ACTIVE)
  suspendedAt DateTime?
  lastLoginAt DateTime?

  // CRM (schema "crm")
  pipelines       Pipeline[]
  deals           Deal[]
  contacts        Contact[]
  companyProfiles CompanyProfile[]
  activities      Activity[]
  tasks           Task[]
  syncLogs        SyncLog[]

  apiKeys        ApiKey[]
  payments       Payment[]
  idempotency    IdempotencyRecord[]
  auditActions AdminAuditLog[] @relation("AdminAuditActor")
  auditTargets AdminAuditLog[] @relation("AdminAuditTarget")

  createdAt DateTime @default(now())

  @@index([role])
  @@index([status])
  @@schema("public")
}

/// Append-only record of every account action a super admin takes. Nothing
/// deletes from here - if an account was suspended or promoted, that fact must
/// remain provable after the fact.
model AdminAuditLog {
  id      String @id @default(cuid())
  actorId String
  actor   User   @relation("AdminAuditActor", fields: [actorId], references: [id], onDelete: Cascade)

  // Null for actions that are not about one specific account.
  targetUserId String?
  target       User?   @relation("AdminAuditTarget", fields: [targetUserId], references: [id], onDelete: SetNull)

  action String // "user.provisioned" | "user.suspended" | "user.restored" | "user.role_changed"
  meta   Json?

  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([actorId, createdAt])
  @@index([targetUserId, createdAt])
  @@schema("public")
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?  @db.Text
  access_token       String?  @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?  @db.Text
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@schema("public")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@schema("public")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@schema("public")
}

model BusinessProfile {
  id            String   @id @default(cuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessName  String
  ownerName     String
  email         String
  phone         String?
  address       String?
  website       String?
  taxId         String?
  logoUrl       String?
  brandColor    String?  @default("#000000")
  paymentMethod String?
  bankName      String?
  accountNumber String?
  routingSwift  String?
  upiId         String?  // UPI VPA for QR-based payment, e.g. name@bank (phase 2 QR code)
  currency      String?  @default("USD") // default currency for new documents

  // Defaults copied onto new documents; editable per-document afterwards.
  defaultTaxMode         TaxMode  @default(NONE)
  defaultTaxRate         Decimal? @db.Decimal(5, 2)
  defaultTaxLabel        String?
  defaultPaymentTermDays Int?     @default(15)

  // Pre-filled into the Notes field of every new invoice-family document, so
  // standard wording is not retyped each time. Editable per document.
  defaultInvoiceNote     String?

  // How generated documents look: the paper they print on and the typeface
  // they are set in. Both are snapshotted onto a document at finalize time,
  // so changing them later never restyles an invoice already sent.
  // See src/lib/document-theme.ts for the derived palette.
  paperColor         String?  @default("#ffffff")
  documentFont       String?  @default("serif")

  // Signature shown on contracts as the issuer's counter-signature.
  signatureName      String?
  signatureImageUrl  String?

  updatedAt DateTime @updatedAt
  @@schema("public")
}

// A client's `code` (e.g. "ACME") is auto-suggested from their business name
// and is editable up until their first document is finalized - after that it
// is locked server-side, because every issued refNumber embeds it
// (INV-ACME-001) and an edited code would orphan historical serials.
model Client {
  id              String     @id @default(cuid())
  userId          String
  user            User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  clientNumber    Int        // sequential internal id, assigned from User.clientSeq
  code            String     // short uppercase code used in document serials
  fullName        String
  businessName    String?
  email           String
  phone           String?
  address         String?
  country         String?
  taxId           String?    // GSTIN or equivalent, shown on invoices when set
  notes           String?
  tags            String[]   // e.g. ["active", "video", "high-value"]
  defaultCurrency String?    // overrides BusinessProfile.currency for this client

  // Identity in the system that pushed this record (CRM, etc). Nullable, and
  // Postgres allows many NULLs under a unique index, so hand-created clients
  // are unaffected. This is what makes a re-sync an update instead of a
  // duplicate.
  externalId   String?
  sourceSystem String?
  archivedAt      DateTime?

  // Per-client serial counters. Incremented transactionally in
  // src/lib/allocate-ref.ts when a document is finalized - never on create,
  // so deleting a draft never leaves a gap in issued numbers.
  // Each type counts separately so converting a quote into an invoice never
  // burns an invoice number, and INV- stays gapless on its own.
  invoiceSeq  Int @default(0)
  contractSeq Int @default(0)
  quoteSeq    Int @default(0)
  proformaSeq Int @default(0)
  receiptSeq  Int @default(0)

  documents Document[]

  // CRM (schema "crm")
  deals           Deal[]
  contacts        Contact[]
  companyProfiles CompanyProfile[]
  activities      Activity[]
  tasks           Task[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@unique([userId, code])
  @@unique([userId, externalId])
  @@index([userId, archivedAt])
  @@index([userId, createdAt])
  @@schema("public")
}

enum DocumentType {
  INVOICE
  CONTRACT
  QUOTE    // quotation / estimate - converts to an INVOICE once accepted
  PROFORMA // proforma invoice - converts to an INVOICE once confirmed
  @@schema("public")
}

// Lifecycle only - money status (paid/partial/overdue) is derived from
// Document.amountPaid vs totalAmount/dueDate, not stored here, so it can
// never drift out of sync with the Payment ledger.
enum DocumentStatus {
  DRAFT     // editable, unnumbered, not shareable
  FINALIZED // numbered + snapshotted + shareable; "SENT" for invoices
  SIGNED    // contracts only, after e-signature; permanently locked
  VOID      // cancelled after finalize; number stays allocated (no reuse)
  ARCHIVED
  @@schema("public")
}

enum TaxMode {
  NONE
  PERCENTAGE
  @@schema("public")
}

model Document {
  id       String @id @default(cuid())
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  clientId String?
  client   Client? @relation(fields: [clientId], references: [id], onDelete: Cascade)

  type   DocumentType
  status DocumentStatus @default(DRAFT)

  // refNumber/sequence are NULL while DRAFT and assigned atomically on
  // finalize by src/lib/allocate-ref.ts, e.g. "INV-ACME-001" / sequence 1.
  refNumber String?
  sequence  Int?

  title   String?
  content Json // line items / clauses; frozen (no longer read from live
  // Client/BusinessProfile rows) once status leaves DRAFT - see
  // src/lib/snapshot.ts

  currency String  @default("USD")
  taxMode  TaxMode @default(NONE)
  taxRate  Decimal? @db.Decimal(5, 2)
  taxLabel String?

  subtotal    Decimal? @db.Decimal(12, 2)
  taxAmount   Decimal? @db.Decimal(12, 2)
  totalAmount Decimal? @db.Decimal(12, 2)
  amountPaid  Decimal  @default(0) @db.Decimal(12, 2)

  // Money already in hand before this invoice was raised - a prior advance or
  // an earlier milestone payment. Deducted from the total on the printed
  // document to give the balance due. Distinct from amountPaid, which is the
  // Payment ledger for THIS document; both count as received (see
  // paymentSummary in src/lib/money.ts).
  advanceReceived Decimal @default(0) @db.Decimal(12, 2)

  issueDate DateTime?
  dueDate   DateTime?

  finalizedAt DateTime?

  publicSlug    String?    @unique // random token, not derived from id
  slugRevokedAt DateTime?

  signatureData Json? // e-signature payload for CONTRACT documents
  contentHash   String? // sha256 of `content` at finalize/sign time, so a

  // later edit can never be passed off as what was actually signed
  // Set on the INVOICE created from an accepted QUOTE/PROFORMA. The source
  // document keeps its own number and is never mutated - conversion copies
  // forward, so both sides stay independently auditable.
  externalId   String?
  sourceSystem String?

  convertedFromId String?
  convertedFrom   Document?  @relation("DocumentConversion", fields: [convertedFromId], references: [id], onDelete: SetNull)
  convertedTo     Document[] @relation("DocumentConversion")

  payments Payment[]
  activity DocumentActivity[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, refNumber])
  @@unique([userId, externalId])
  @@index([userId, type])
  @@index([userId, status])
  // Covers the list pages: WHERE userId = ? ORDER BY createdAt DESC. Without
  // it Postgres can filter or sort from an index, but not both.
  @@index([userId, createdAt])
  @@index([convertedFromId])
  @@index([clientId])
  @@schema("public")
}

/// Per-tenant API credential for the public REST surface (src/app/api/v1).
/// Only a SHA-256 of the secret is stored - the plaintext is shown once at
/// creation and is unrecoverable afterwards.
model ApiKey {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name String // human label, e.g. "HubSpot production"

  /// Public, non-secret prefix used to find the row before verifying the
  /// hash. Indexed so lookup never scans, and safe to display in the UI.
  lookupId String @unique
  keyHash  String // sha256 of the full secret

  lastUsedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId, revokedAt])
  @@schema("public")
}

/// Replay protection for unsafe API calls. A retried POST with the same
/// Idempotency-Key returns the stored response instead of creating a second
/// client or document.
model IdempotencyRecord {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  key      String
  endpoint String
  /// Hash of the request body, so the same key sent with different content is
  /// rejected rather than silently returning the wrong stored response.
  requestHash    String
  responseStatus Int
  responseBody   Json

  createdAt DateTime @default(now())

  @@unique([userId, key])
  @@index([createdAt])
  @@schema("public")
}

model Payment {
  id         String   @id @default(cuid())
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  // Denormalised from the parent document so a receipt number can carry the
  // same @@unique backstop the document serials have - Payment is otherwise
  // only reachable through Document and could not be scoped per tenant.
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Allocated when the payment is recorded, e.g. RCP-ACME-001. A receipt
  // acknowledges money that has already moved, so unlike a document it is
  // never a draft and never needs finalising.
  receiptNumber String?
  sequence      Int?
  amount     Decimal  @db.Decimal(12, 2)
  paidOn     DateTime
  method     String? // "UPI", "Bank transfer", "Cash", ...
  reference  String?
  note       String?
  createdAt  DateTime @default(now())

  @@unique([userId, receiptNumber])
  @@index([documentId])
  @@index([userId, paidOn])
  @@schema("public")
}

model DocumentActivity {
  id         String   @id @default(cuid())
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  event      String // "created" | "finalized" | "shared" | "viewed" |
  // "downloaded" | "signed" | "payment_recorded" | "voided"
  meta      Json?
  createdAt DateTime @default(now())

  @@index([documentId, createdAt])
  @@schema("public")
}

// ---------------------------------------------------------------------------
// CRM (schema "crm")
//
// Created by an earlier codebase against this same database and adopted here
// rather than rebuilt: it already carries real foreign keys into public.User
// and public.Client, so a deal, a contact and a task all hang off the same
// client the invoices do. Stages live in rows, not in an enum, so the pipeline
// is configuration the operator edits rather than a deploy.
//
// Migrations for these tables are tracked in crm._prisma_migrations by that
// original app. This block describes the tables; it does not re-create them.
// ---------------------------------------------------------------------------

enum ActivityType {
  NOTE
  CALL
  EMAIL
  MEETING
  STAGE_CHANGE
  DEAL_WON
  DEAL_LOST
  CLIENT_SYNCED
  TASK_COMPLETED

  @@schema("crm")
}

enum DealOutcome {
  WON
  LOST

  @@schema("crm")
}

enum LifecycleStage {
  LEAD
  PROSPECT
  ACTIVE
  DORMANT
  CHURNED

  @@schema("crm")
}

/// OPEN stages sit in the pipeline; WON and LOST close a deal and are what the
/// board reads to decide where a stage move ends the story.
///
/// The same three apply to every board kind: a project's "Completed" is a WON
/// stage and its "Cancelled" is LOST, a task's "Done" is WON. Only the names
/// differ, which is the point - one board implementation, three panels.
enum StageType {
  OPEN
  WON
  LOST

  @@schema("crm")
}

/// What a board holds.
///
/// Leads, projects and tasks are the same primitive: ordered cards in named
/// columns. Discriminating the pipeline rather than building three board
/// systems is what makes "customise the stages" one settings screen instead
/// of three, and lets one drag-and-drop implementation serve all of them.
enum PipelineKind {
  LEADS
  PROJECTS
  TASKS

  @@schema("crm")
}

enum SyncDirection {
  PUSH
  PULL

  @@schema("crm")
}

enum SyncStatus {
  SUCCESS
  FAILED

  @@schema("crm")
}

enum TaskPriority {
  LOW
  NORMAL
  HIGH

  @@schema("crm")
}

enum TaskStatus {
  OPEN
  DONE
  CANCELLED

  @@schema("crm")
}

model Pipeline {
  id         String    @id
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  /// Existing rows predate the other two panels, so they are LEADS.
  kind       PipelineKind @default(LEADS)
  isDefault  Boolean
  position   Int
  archivedAt DateTime?
  createdAt  DateTime
  updatedAt  DateTime

  stages   Stage[]
  deals    Deal[]
  projects Project[]
  tasks    Task[]

  @@schema("crm")
}

model Stage {
  id          String @id
  pipelineId  String
  pipeline    Pipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  name        String
  position    Int
  /// Win likelihood at this stage, used for weighted pipeline value. Only
  /// meaningful on a LEADS board; the other kinds carry zero.
  probability Int
  type        StageType
  createdAt   DateTime
  updatedAt   DateTime

  deals    Deal[]
  projects Project[]
  tasks    Task[]

  @@schema("crm")
}

/// An opportunity. Separate from Client on purpose: a client can be quoted
/// twice, and a deal that never closes must not fill the client list.
model Deal {
  id               String    @id
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title            String
  description      String?
  clientId         String?
  client           Client?   @relation(fields: [clientId], references: [id])
  primaryContactId String?
  primaryContact   Contact?  @relation(fields: [primaryContactId], references: [id])
  pipelineId       String
  pipeline         Pipeline  @relation(fields: [pipelineId], references: [id])
  stageId          String
  stage            Stage     @relation(fields: [stageId], references: [id])
  value            Decimal?
  currency         String
  probability      Int?
  expectedCloseDate DateTime?
  closedAt         DateTime?
  outcome          DealOutcome?
  lostReason       String?
  source           String?
  /// Order within its stage column on the board.
  position         Int
  archivedAt       DateTime?
  createdAt        DateTime
  updatedAt        DateTime

  activities Activity[]
  tasks      Task[]

  @@schema("crm")
}

/// A person. Attaches to a Client once there is one, and stands alone before.
model Contact {
  id          String    @id
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  clientId    String?
  client      Client?   @relation(fields: [clientId], references: [id])
  firstName   String
  lastName    String?
  email       String?
  phone       String?
  jobTitle    String?
  linkedinUrl String?
  notes       String?
  isPrimary   Boolean
  archivedAt  DateTime?
  createdAt   DateTime
  updatedAt   DateTime

  deals      Deal[]
  activities Activity[]
  tasks      Task[]

  @@schema("crm")
}

/// The commercial facts about a Client that invoicing has no use for.
/// PLACEHOLDER_COMPANY_MARKER
model CompanyProfile {
  id             String   @id
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  clientId       String
  client         Client   @relation(fields: [clientId], references: [id])
  website        String?
  industry       String?
  employeeCount  String?
  lifecycleStage LifecycleStage
  accountManager String?
  source         String?
  linkedinUrl    String?
  createdAt      DateTime
  updatedAt      DateTime

  @@schema("crm")
}

/// Append-only trail. Stage moves, calls, notes and syncs all land here, so a
/// deal's history reads in one query.
model Activity {
  id         String       @id
  userId     String
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       ActivityType
  subject    String?
  body       String?
  occurredAt DateTime
  dealId     String?
  deal       Deal?        @relation(fields: [dealId], references: [id])
  clientId   String?
  client     Client?      @relation(fields: [clientId], references: [id])
  contactId  String?
  contact    Contact?     @relation(fields: [contactId], references: [id])
  meta       Json?
  createdAt  DateTime

  @@schema("crm")
}

/// The follow-up. dueAt is what the agenda view and the calendar read.
model Task {
  id          String       @id
  userId      String
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  notes       String?
  status      TaskStatus
  priority    TaskPriority
  dueAt       DateTime?
  completedAt DateTime?
  dealId      String?
  deal        Deal?        @relation(fields: [dealId], references: [id])
  clientId    String?
  client      Client?      @relation(fields: [clientId], references: [id])
  contactId   String?
  contact     Contact?     @relation(fields: [contactId], references: [id])
  createdAt   DateTime
  updatedAt   DateTime

  @@schema("crm")
}

/// Every exchange with an outside system, kept whether it succeeded or not, so
/// a failed Meta pull is visible instead of silent.
model SyncLog {
  id         String        @id
  userId     String
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  direction  SyncDirection
  entity     String
  localId    String?
  remoteId   String?
  status     SyncStatus
  statusCode Int?
  error      String?
  payload    Json?
  createdAt  DateTime

  @@schema("crm")
}
